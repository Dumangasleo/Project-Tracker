NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=change-me
DB_NAME=VortexSyncDB
# true only in development; use migrations in production
DB_SYNC=true

RABBITMQ_URL=amqp://guest:guest@localhost:5672

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ALLOWED_CLIENT_IDS=vortex-web,vortex-swagger
CLIENT_TIMESTAMP_TOLERANCE_SEC=300

# SSO (leave blank to hide the button). Redirect URI: {SSO_CALLBACK_BASE_URL}/api/v1/auth/sso/{google|microsoft}/callback
SSO_CALLBACK_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Encrypts emails, contact numbers and addresses in the database. At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Keep it safe: if it is lost, encrypted data cannot be read. Never change it once data is encrypted.
DATA_ENCRYPTION_KEY=
